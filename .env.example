# -----------------------------------------------------------------------------
# Root .env.example — config is APP-SCOPED. Copy the relevant blocks into
# apps/web/.env and apps/worker/.env (see those .env.example files).
# -----------------------------------------------------------------------------

# ---------- Shared (both web + worker) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autotest
REDIS_URL=redis://localhost:6379

# AES-256-GCM key (base64, 32 bytes) used to encrypt module credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# ---------- Web (apps/web/.env) ----------
AUTH_SECRET=change-me-32-bytes-min-random-secret-x
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
AI_PROVIDER=mock

# ---------- Worker (apps/worker/.env) ----------
BROWSER_HEADLESS=true
DISCOVERY_MAX_PAGES=20
DISCOVERY_MAX_STEPS=200
DISCOVERY_NAVIGATION_DEPTH=3
DISCOVERY_TIMEOUT_MS=30000
WORKER_CONCURRENCY=2

# ---------- Object storage (optional; local filesystem used by default) ----------
# STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=autotest-artifacts
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ---------- AI (optional; deterministic discovery works without it) ----------
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=llama3.1

# ---------- Demo target app (apps/demo-app) ----------
DEMO_APP_URL=http://localhost:4000