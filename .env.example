# -----------------------------------------------------------------------------
# Root .env.example — config is APP-SCOPED. Copy the relevant blocks into
# apps/web/.env and apps/worker/.env (see those .env.example files).
# -----------------------------------------------------------------------------

# ---------- Shared (both web + worker) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autotest
# Job queue lives in Postgres (job_queue table); Redis is not used.

# AES-256-GCM key (base64, 32 bytes) used to encrypt module credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# ---------- Web (apps/web/.env) ----------
AUTH_SECRET=change-me-32-bytes-min-random-secret-x
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Evidence screenshots: Neon Storage (S3-compatible) bucket. Images are always
# served through the app's authorized /api/storage route, so keep the bucket private.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<branch-id>.storage.<region>.aws.neon.tech
S3_REGION=ap-southeast-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000
AI_PROVIDER=mock

# ---------- Worker (apps/worker/.env) ----------
BROWSER_HEADLESS=true
DISCOVERY_MAX_PAGES=20
DISCOVERY_MAX_STEPS=200
DISCOVERY_NAVIGATION_DEPTH=3
DISCOVERY_TIMEOUT_MS=30000
WORKER_CONCURRENCY=2

# ---------- Object storage (optional; local filesystem used by default) ----------

# ---------- AI (optional; deterministic discovery works without it) ----------
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=llama3.1
#
# Gemini: page interpretation, workflow analysis and test-case generation.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------- AI browser agent (worker; uses AI_PROVIDER above) ----------
# With a real AI_PROVIDER (e.g. gemini) the worker's browser agent handles
# unfamiliar login forms, skips irreversible actions during discovery, finds
# moved elements during execution, and runs GOAL steps. Playwright performs
# every action; credentials are offered to the model by name only.
# AGENT_GUARD_IRREVERSIBLE=true

# ---------- Demo target app (apps/demo-app) ----------
DEMO_APP_URL=http://localhost:4000