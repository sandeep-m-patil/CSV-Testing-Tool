# Database (PostgreSQL / Neon). Required.
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require

# Job queue lives in Postgres (job_queue table); Redis is not used.

# 32-byte base64 key used to encrypt stored credentials.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to use the insecure dev fallback (never in production).
CREDENTIAL_ENCRYPTION_KEY=

# Local storage driver shared with the web app (screenshots / evidence).
# Use an absolute or workspace-relative path so both processes read the same dir.
# Evidence screenshots: Neon Storage (S3-compatible) bucket. Images are always
# served through the app's authorized /api/storage route, so keep the bucket private.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<branch-id>.storage.<region>.aws.neon.tech
S3_REGION=ap-southeast-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=../data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000

# AI provider: mock | openai | gemini | grok | local
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=

# AI browser agent (Playwright + AI_PROVIDER): login assist, irreversible-action
# guard, element fallback and GOAL steps. On by default when AI_PROVIDER is real.
AGENT_GUARD_IRREVERSIBLE=true

# Browser
BROWSER_HEADLESS=true
BROWSER_ISOLATED_CONTEXT=true

# Discovery budgets
DISCOVERY_MAX_PAGES=20
DISCOVERY_MAX_STEPS=60
DISCOVERY_NAVIGATION_DEPTH=3
DISCOVERY_MAX_ACTIONS_PER_PAGE=5
DISCOVERY_TIMEOUT_MS=30000
DISCOVERY_PAGE_SLEEP_MS=400

# Worker
WORKER_CONCURRENCY=1
LOG_LEVEL=info