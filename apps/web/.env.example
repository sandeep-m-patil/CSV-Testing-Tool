# -----------------------------------------------------------------------------
# apps/web/.env — copy to apps/web/.env and fill in real values.
# NEVER commit real .env files.
# -----------------------------------------------------------------------------

# --- Database (Neon PostgreSQL in production, local Postgres in development) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autotest
# Neon example:
# DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# Job queue lives in Postgres (job_queue table); Redis is not used.

# --- Auth ---
# At least 32 characters. Generate: openssl rand -base64 48
AUTH_SECRET=dev-only-secret-change-me-32-chars-minimum

# --- Credential encryption (AES-256-GCM, base64 32 bytes) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=

# --- Object storage ---
# Evidence screenshots: Neon Storage (S3-compatible) bucket. Images are always
# served through the app's authorized /api/storage route, so keep the bucket private.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<branch-id>.storage.<region>.aws.neon.tech
S3_REGION=ap-southeast-1
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=./data/storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000


# --- AI (optional; discovery is fully deterministic without it) ---
AI_PROVIDER=mock
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# AI_PROVIDER=local
# LOCAL_AI_BASE_URL=http://localhost:11434/v1
# LOCAL_AI_MODEL=llama3.1

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info